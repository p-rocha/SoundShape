# Clear environment prior to package
rm(list=ls())
# Define working directory where package will be created
setwd("C:/SoundShape/Package-devel")
# Create folder where package will be stored
#create("SoundShape")
# Process documentation (each function edited manually)
document("C:/SoundShape/Package-devel")
# Install package directly
install("C:/SoundShape/Package-devel")
# Build package
build("C:/SoundShape/Package-devel")
# R CMD check
#dir("C:/R", pattern="tar.gz")
check_built("C:/SoundShape/SoundShape_1.3.1.tar.gz")
setwd("C:\Users\n10832777\OneDrive - Queensland University of Technology\R\Analises para terceiros\Karianne")
setwd("C:/Users/n10832777/OneDrive - Queensland University of Technology/R/Analises para terceiros/Karianne")
# Create a folder to store original ".wav" files
orig.wav <- file.path(getwd(), "Workflow sample", "original wave")
dir.create(orig.wav)
# Create a folder to store original ".wav" files
orig.wav <- file.path(getwd(), "original wave")
# Create a folder to store ".wav" samples
wav.at <- file.path(getwd(), "wav samples")
dir.create(wav.at)
# Create a folder to store original ".wav" files
orig.wav <- file.path(getwd(), "original wave")
dir.create(orig.wav)
# Create subfolder to store results
store.at <- file.path(getwd(), "output")
dir.create(store.at)
# Export a ".wav" sample for each selection made in Raven Pro
raven.to.wave(orig.wav.folder = orig.wav, wav.samples = wav.at)
# Verify samples
dir(wav.at)
#  Align acoustic units using align.wave
align.wave(wav.at=wav.at, wav.to="Aligned",
time.length = 1.3, time.perc = 0.005, dBlevel = 25)
#  Align acoustic units using align.wave
align.wave(wav.at=wav.at, wav.to="Aligned",
time.length = 1.3, time.perc = 0.005, dBlevel = 15)
#  Align acoustic units using align.wave
align.wave(wav.at=wav.at, wav.to="Aligned",
time.length = 1.3, time.perc = 0.005, dBlevel = 10)
#  Align acoustic units using align.wave
align.wave(wav.at=wav.at, wav.to="Aligned",
time.length = 1.3, time.perc = 0.001, dBlevel = 10)
# Verify alignment using analysis.type = "twoDshape"
eigensound(analysis.type = "twoDshape", wav.at = file.path(wav.at, "Aligned"),
dBlevel = 10, store.at=store.at, plot.exp=TRUE,
flim=c(0, 1), tlim=c(0, 1.3), add.contour = TRUE)
#  Align acoustic units using align.wave
align.wave(wav.at=wav.at, wav.to="Aligned",
time.length = 0.8, time.perc = 0.001, dBlevel = 10)
# Verify alignment using analysis.type = "twoDshape"
eigensound(analysis.type = "twoDshape", wav.at = file.path(wav.at, "Aligned"),
dBlevel = 10, store.at=store.at, plot.exp=TRUE,
flim=c(0, 1), tlim=c(0, 0.8), add.contour = TRUE)
# Export 3D graphs with semilandmarks as colored points for inspection
eigensound(analysis.type="threeDshape", plot.type="points",
wav.at=file.path(wav.at, "Aligned"), store.at=store.at,
dBlevel=10, plot.exp=TRUE, flim=c(0, 1), tlim=c(0, 0.8), log.scale=FALSE)
# Sample semilandmarks for each ".wav" file on a folder
eig.sample.linear <- eigensound(
analysis.type="threeDshape", wav.at=file.path(wav.at, "Aligned"),
dBlevel=10, plot.exp=FALSE, flim=c(0, 1), tlim=c(0, 0.8),log.scale=FALSE)
# PCA using 3D semilandmark coordinates
pca.linear.sample <- stats::prcomp(geomorph::two.d.array(eig.sample.linear))
# View summary results
summary(pca.linear.sample)
# Mean shape configuration (consensus)
hypo.surf(eig.sample.linear, plot.exp=TRUE, store.at=store.at,  PC="mean",
flim=c(0, 1), tlim=c(0, 0.8))
# Minimum and maximum deformations - Principal Component 1
hypo.surf(eig.sample.linear, plot.exp=TRUE, store.at=store.at,  PC=1,
flim=c(0, 1), tlim=c(0, 0.8))
# Minimum and maximum deformations - Principal Component 2
hypo.surf(eig.sample.linear, plot.exp=TRUE, store.at=store.at,  PC=2,
flim=c(0, 1), tlim=c(0, 0.8))
# PCA using three-dimensional semilandmark coordinates
pca.eig.sample <- stats::prcomp(geomorph::two.d.array(eig.sample))
# Ordination plot
pca.plot(pca.eig.sample, main="Ordination of PC coordinates")
plot(pca.eig.sample)
plot(pca.linear.sample)
# PCA using three-dimensional semilandmark coordinates
pca.eig.sample <- stats::prcomp(geomorph::two.d.array(eig.sample.linear))
plot(pca.eig.sample)
biplot(pca.eig.sample)
?pca.plot()
pca.plot
graphics::plot(pca.eig.sample$x[,1], pca.eig.sample$x[,2])
graphics::plot(pca.eig.sample$x[,1], pca.eig.sample$x[,2])
